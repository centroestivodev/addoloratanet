---
// Pagina di prova, visibile solo in sviluppo: la galleria delle notizie con le
// copertine delle ultime notizie, senza modificare nulla su Sanity.
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Gallery from "../components/Gallery.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { sanityClient } from "../sanity/lib/client";

const images = await sanityClient.fetch<any[]>(
	`*[_type == "post" && defined(images[0].asset)] | order(coalesce(publishedAt, _createdAt) desc)[0...6].images[0]`,
);
---

<Layout title="Prova galleria" description="Pagina di prova della galleria." noindex>
	<Container class="page-top">
		<SectionHeading as="h1" size="lg" title="Prova galleria" class="mb-6" />
		<Gallery images={images} />
	</Container>
</Layout>
