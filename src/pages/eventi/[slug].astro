---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import { sanityClient } from "sanity:client";
import { urlFor } from "../../sanity/lib/image";
import { truncate } from "../../sanity/lib/text";
import { formatEventDate } from "../../sanity/lib/eventDate";

export async function getStaticPaths() {
	const events = await sanityClient.fetch<{ slug: string }[]>(
		`*[_type == "event" && defined(slug.current)]{ "slug": slug.current }`
	);
	return events.map((event) => ({ params: { slug: event.slug } }));
}

const { slug } = Astro.params;

const event = await sanityClient.fetch(
	`*[_type == "event" && slug.current == $slug][0]{
		title, description, image, eventDate, startTime, endDate, endTime,
		"imageDimensions": image.asset->metadata.dimensions,
		"relatedPost": relatedPost->{ title, "slug": slug.current }
	}`,
	{ slug }
);

if (!event) {
	return Astro.redirect("/eventi");
}

const imageWidth = 1200;
const imageHeight = event.imageDimensions
	? Math.round((imageWidth * event.imageDimensions.height) / event.imageDimensions.width)
	: undefined;
---

<Layout title={event.title} description={truncate(event.description, 160)}>
	<Container class="py-12">
		<div class="max-w-3xl mx-auto">
			<a href="/eventi" class="link link-hover text-sm text-base-content/60">← Calendario</a>

			<span class="block text-xs text-base-content/60 mt-4">
				{formatEventDate(event)}
			</span>
			<h1 class="text-3xl font-bold mt-2 mb-6">{event.title}</h1>

			{
				event.image && (
					<img
						src={urlFor(event.image).width(imageWidth).auto("format").url()}
						width={imageWidth}
						height={imageHeight}
						alt={event.image.alt || event.title}
						class="rounded-box mb-8 w-full h-auto"
						loading="eager"
						decoding="async"
					/>
				)
			}

			<p class="whitespace-pre-line leading-relaxed">{event.description}</p>

			{
				event.relatedPost?.slug && (
					<a href={`/notizie/${event.relatedPost.slug}`} class="link link-primary inline-block mt-8">
						Leggi di più: {event.relatedPost.title} →
					</a>
				)
			}
		</div>
	</Container>
</Layout>
