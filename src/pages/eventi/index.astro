---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import EventListItem from "../../components/EventListItem.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import Tabs from "../../components/ui/Tabs.astro";
import { sanityClient } from "sanity:client";
import { groupByMonth, todayInRome } from "../../sanity/lib/eventDate";
import { EVENT_CARD_FIELDS, type EventCard, type Tag } from "../../sanity/lib/queries";

// Pagina generata a ogni richiesta, per separare i prossimi eventi da quelli passati in base a oggi.
// Vista e filtro arrivano dall'indirizzo: ?vista=passati&tag=…
export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
Astro.response.headers.set("Netlify-CDN-Cache-Control", "public, durable, s-maxage=300, stale-while-revalidate=3600");

const params = Astro.url.searchParams;
const past = params.get("vista") === "passati";
const filter = params.get("tag") || "tutti";

const events = await sanityClient.fetch<EventCard[]>(
	past
		? `*[_type == "event" && defined(slug.current) && coalesce(endDate, eventDate) < $today]
			| order(eventDate desc, startTime desc){ ${EVENT_CARD_FIELDS} }`
		: `*[_type == "event" && defined(slug.current) && coalesce(endDate, eventDate) >= $today]
			| order(eventDate asc, startTime asc){ ${EVENT_CARD_FIELDS} }`,
	{ today: todayInRome() },
);

// Le schede dei filtri mostrano solo i tag presenti negli eventi di questa vista
const tagMap = new Map<string, Tag>();
for (const event of events) for (const tag of event.tags ?? []) if (tag.slug) tagMap.set(tag.slug, tag);
const tags = [...tagMap.values()].sort((a, b) => a.name.localeCompare(b.name, "it"));

const visible = filter === "tutti" ? events : events.filter((e) => e.tags?.some((t) => t.slug === filter));
const months = groupByMonth(visible, (e) => e.eventDate);

function hrefFor({ vista = past ? "passati" : "prossimi", tag = filter }: { vista?: string; tag?: string }) {
	const search = new URLSearchParams();
	if (vista === "passati") search.set("vista", "passati");
	if (tag !== "tutti") search.set("tag", tag);
	const qs = search.toString();
	return qs ? `/eventi?${qs}` : "/eventi";
}

const viewTabs = [
	{ label: "Prossimi", href: hrefFor({ vista: "prossimi" }), active: !past },
	{ label: "Già svolti", href: hrefFor({ vista: "passati" }), active: past },
];
const filterTabs = [{ slug: "tutti", name: "Tutti" }, ...tags].map((t) => ({
	label: t.name,
	href: hrefFor({ tag: t.slug }),
	active: t.slug === filter,
}));

const emptyText =
	filter === "tutti"
		? past
			? "Non ci sono appuntamenti passati."
			: "Al momento non ci sono appuntamenti in programma."
		: past
			? "Nessun appuntamento passato con questa etichetta."
			: "Nessun appuntamento in programma con questa etichetta.";
---

<Layout
	title="Calendario"
	description="Gli appuntamenti, le celebrazioni e le iniziative della Parrocchia Santa Maria Addolorata."
>
	<Container class="calendario">
		<div class="calendario__head">
			<SectionHeading
				as="h1"
				size="lg"
				title="Calendario"
				description="Gli appuntamenti della comunità: celebrazioni, incontri, feste."
			/>
			<Tabs label="Periodo" items={viewTabs} />
		</div>
		{
			filterTabs.length > 1 && (
				<div class="tabs-scroll">
					<Tabs variant="underline" label="Filtra per etichetta" items={filterTabs} />
				</div>
			)
		}

		<div class="calendario__months">
			{months.length === 0 && <p class="calendario__empty">{emptyText}</p>}
			{
				months.map((month) => (
					<section class="calendario__month">
						<div class="calendario__month-head">
							<h2>{month.label}</h2>
							<span>{month.items.length === 1 ? "1 appuntamento" : `${month.items.length} appuntamenti`}</span>
						</div>
						{month.items.map((event) => (
							<EventListItem event={event} />
						))}
					</section>
				))
			}
		</div>
	</Container>
</Layout>

<style>
	:global(.calendario) {
		padding-top: 48px;
	}
	.calendario__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}
	.tabs-scroll {
		margin: 28px calc(-1 * var(--container-pad)) 0;
		padding: 0 var(--container-pad);
		overflow-x: auto;
		scrollbar-width: none;
	}
	@media (max-width: 639px) {
		.tabs-scroll :global(.tabs-ds) {
			flex-wrap: nowrap;
			max-width: none;
			min-width: 100%;
		}
	}
	.calendario__months {
		max-width: 880px;
		display: flex;
		flex-direction: column;
		gap: 44px;
		margin-top: 36px;
	}
	.calendario__empty {
		margin: 0;
		font-size: 16px;
		color: var(--text-muted);
	}
	.calendario__month {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.calendario__month-head {
		display: flex;
		align-items: baseline;
		gap: 12px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--border-default);
		margin-bottom: 6px;
	}
	.calendario__month-head h2 {
		margin: 0;
		font: var(--type-h3);
		color: var(--text-strong);
	}
	.calendario__month-head span {
		font-size: 14px;
		color: var(--text-muted);
	}
</style>
