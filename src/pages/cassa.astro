---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Cassa, { type CassaProduct } from "../components/cassa/Cassa";
import { sanityClient } from "../sanity/lib/client";
import { urlFor } from "../sanity/lib/image";
import { formatDay, todayInRome } from "../sanity/lib/eventDate";
import { CASSA_EVENTS, CASSA_PRODUCTS, type CassaEventDoc, type CassaProductDoc } from "../sanity/lib/queries";

// Pagina di servizio per le feste: dati letti a ogni richiesta, mai indicizzata
export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

const [docs, eventDocs] = await Promise.all([
	sanityClient.fetch<CassaProductDoc[]>(CASSA_PRODUCTS),
	sanityClient.fetch<CassaEventDoc[]>(CASSA_EVENTS),
]);

const products: CassaProduct[] = docs.map((p) => ({
	id: p.id,
	name: p.name,
	description: p.description,
	priceCents: p.priceCents,
	isCombo: p.isCombo,
	image: p.image?.asset ? urlFor(p.image).width(400).height(240).auto("format").url() : undefined,
	components: p.components ?? [],
	events: p.events ?? [],
}));

const events = eventDocs.map((e) => ({ id: e.id, label: `${e.title} · ${formatDay(e.eventDate)}` }));

// Evento preselezionato: quello in corso oggi, altrimenti il prossimo, altrimenti l'ultimo passato
const today = todayInRome();
const inProgress = eventDocs.find((e) => e.eventDate <= today && (e.endDate ?? e.eventDate) >= today);
const upcoming = eventDocs.filter((e) => e.eventDate > today).sort((a, b) => a.eventDate.localeCompare(b.eventDate))[0];
const initialEventId = (inProgress ?? upcoming ?? eventDocs[0])?.id;
---

<Layout title="Cassa" description="Cassa per le feste della parrocchia." noindex>
	<Container class="page-top">
		<SectionHeading as="h1" size="lg" title="Cassa" description="Scegli l'evento e batti il conto." />
		<Cassa client:load products={products} events={events} initialEventId={initialEventId} />
	</Container>
</Layout>
