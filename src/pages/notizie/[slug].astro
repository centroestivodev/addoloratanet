---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import PortableTextBody from "../../components/PortableTextBody";
import NewsCard from "../../components/NewsCard.astro";
import EventMiniRow from "../../components/EventMiniRow.astro";
import Badge from "../../components/ui/Badge.astro";
import Icon from "../../components/ui/Icon.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import TextLink from "../../components/ui/TextLink.astro";
import { sanityClient } from "sanity:client";
import { urlFor } from "../../sanity/lib/image";
import { toPlainText } from "../../sanity/lib/portableText";
import {
	formatDateTimeLong,
	formatShortDate,
	isPastEvent,
	todayInRome,
	type EventSchedule,
} from "../../sanity/lib/eventDate";
import { PARROCO_BADGE, POST_CARD_FIELDS, TAG_FIELDS, type PostCard, type Tag } from "../../sanity/lib/queries";

// Pagina generata a ogni richiesta, per separare gli incontri futuri da quelli già svolti
export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
Astro.response.headers.set("Netlify-CDN-Cache-Control", "public, durable, s-maxage=300, stale-while-revalidate=3600");

type LinkedEvent = EventSchedule & { _id: string; title: string; slug: string };

const { slug } = Astro.params;

const post = await sanityClient.fetch(
	`*[_type == "post" && slug.current == $slug][0]{
		_id, title, images, body, badge,
		"publishedAt": coalesce(publishedAt, _createdAt),
		"tags": tags[]->{ ${TAG_FIELDS} },
		"attachments": attachments[]{ title, "url": asset->url, "filename": asset->originalFilename, "size": asset->size, "extension": asset->extension },
		"events": *[_type == "event" && references(^._id) && defined(slug.current)] | order(eventDate asc, startTime asc){
			_id, title, "slug": slug.current, eventDate, startTime, endDate, endTime
		},
		"others": *[_type == "post" && defined(slug.current) && slug.current != $slug]
			| order(coalesce(publishedAt, _createdAt) desc)[0...3]{ ${POST_CARD_FIELDS} }
	}`,
	{ slug },
);

if (!post) {
	return Astro.redirect("/notizie");
}

const today = todayInRome();
const tags: Tag[] = (post.tags ?? []).filter(Boolean);
const attachments: { title?: string; url?: string; filename?: string; size?: number; extension?: string }[] =
	post.attachments ?? [];
const events: LinkedEvent[] = post.events ?? [];
const nextEvents = events.filter((e) => !isPastEvent(e, today));
const pastEvents = events.filter((e) => isPastEvent(e, today)).reverse();
const others: PostCard[] = post.others ?? [];
const [cover, ...gallery] = (post.images ?? []).filter((img: any) => img?.asset);
const hasAside = tags.length > 0 || attachments.length > 0 || events.length > 0;
const eventsTitle = events.length > 2 ? "Gli incontri" : events.length === 1 ? "L’appuntamento" : "Gli appuntamenti";

const sizeFormatter = new Intl.NumberFormat("it-IT", { maximumFractionDigits: 1 });
function formatSize(bytes?: number) {
	if (!bytes) return "";
	if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
	return `${sizeFormatter.format(bytes / (1024 * 1024))} MB`;
}
function attachmentMeta(file: (typeof attachments)[number]) {
	const first = file.title ? file.filename : file.extension?.toUpperCase();
	return [first, formatSize(file.size)].filter(Boolean).join(" · ");
}
---

<Layout title={post.title} description={toPlainText(post.body, 160)}>
	<Container class="page-top">
		<article>
			<TextLink href="/notizie" arrow="left">Avvisi e notizie</TextLink>
			<div class="post-head">
				<div class="post-head__meta">
					{post.badge === PARROCO_BADGE && <Badge tone="navy">Comunicazione del parroco</Badge>}
					<span>{formatDateTimeLong(post.publishedAt)}</span>
				</div>
				<h1>{post.title}</h1>
			</div>

			{
				cover && (
					<img
						src={urlFor(cover).width(2400).height(1200).auto("format").url()}
						width="2400"
						height="1200"
						alt={cover.alt || ""}
						class="post-cover"
						loading="eager"
						decoding="async"
					/>
				)
			}

			<div class="post-layout">
				<div class="post-main">
					<PortableTextBody value={post.body} />
					{
						gallery.length > 0 && (
							<>
								<h2 class="post-gallery-title">Foto</h2>
								<div class="post-gallery">
									{gallery.map((img: any) => (
										<a href={urlFor(img).width(2000).auto("format").url()} target="_blank" rel="noopener">
											<img
												src={urlFor(img).width(600).height(450).auto("format").url()}
												width="600"
												height="450"
												alt={img.alt || ""}
												loading="lazy"
												decoding="async"
											/>
										</a>
									))}
								</div>
							</>
						)
					}
				</div>

				{
					hasAside && (
						<aside class="post-aside">
							<div class="panel post-aside__panel">
								{tags.length > 0 && (
									<div class="post-aside__section">
										<h2 class="caption-title">Etichette</h2>
										<div class="post-tags">
											{tags.map((tag) => (
												<a href={`/notizie?tag=${tag.slug}`} class="post-tag">
													<span style={{ background: tag.color || "var(--stone-400)" }} />
													{tag.name}
												</a>
											))}
										</div>
									</div>
								)}
								{attachments.length > 0 && (
									<div class="post-aside__section post-aside__section--files">
										<h2 class="caption-title">Allegati</h2>
										{attachments.map((file) => (
											<a href={file.url} class="row-link post-file" target="_blank" rel="noopener noreferrer">
												<span class="post-file__icon">
													<Icon name="file-text" size={20} />
												</span>
												<span class="post-file__text">
													<span class="post-file__name">{file.title || file.filename}</span>
													<span class="post-file__meta">{attachmentMeta(file)}</span>
												</span>
												<span class="post-file__download">
													<Icon name="download" size={18} />
												</span>
											</a>
										))}
									</div>
								)}
								{events.length > 0 && (
									<div class="post-aside__section post-aside__section--events">
										<h2 class="caption-title">{eventsTitle}</h2>
										{nextEvents.map((event) => (
											<EventMiniRow event={event} />
										))}
										{pastEvents.length > 0 && (
											<>
												<h3 class="caption-title post-past-title">Già svolti</h3>
												<div>
													{pastEvents.map((event) => (
														<a href={`/eventi/${event.slug}`} class="post-past">
															<span class="post-past__date">{formatShortDate(event.eventDate)}</span>
															<span class="post-past__title">{event.title}</span>
														</a>
													))}
												</div>
											</>
										)}
									</div>
								)}
							</div>
						</aside>
					)
				}
			</div>

			{
				others.length > 0 && (
					<div class="post-others">
						<SectionHeading align="center" ornament title="Altre notizie" />
						<div class="post-others__grid">
							{others.map((p) => (
								<NewsCard post={p} />
							))}
						</div>
					</div>
				)
			}
		</article>
	</Container>
</Layout>

<style>
	.post-head {
		max-width: 820px;
	}
	.post-head__meta {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		margin: 28px 0 14px;
		font-size: 14px;
		color: var(--text-muted);
	}
	h1 {
		margin: 0;
		font: var(--type-h1);
		letter-spacing: var(--ls-tight);
		color: var(--text-strong);
		text-wrap: balance;
	}
	.post-cover {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border-radius: var(--radius-lg);
		margin-top: 36px;
	}
	.post-layout {
		display: flex;
		flex-wrap: wrap;
		gap: 48px clamp(40px, 6vw, 88px);
		margin-top: 44px;
		align-items: flex-start;
	}
	.post-main {
		flex: 1 1 520px;
		min-width: 0;
		max-width: 720px;
	}
	.post-gallery-title {
		margin: 36px 0 16px;
		font: var(--type-h4);
		color: var(--text-strong);
	}
	.post-gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
		gap: 12px;
	}
	.post-gallery img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius-md);
	}
	.post-aside {
		flex: 1 1 300px;
		min-width: 0;
		max-width: 380px;
		position: sticky;
		top: 96px;
		align-self: flex-start;
	}
	.post-aside__panel {
		display: flex;
		flex-direction: column;
	}
	.post-aside__section {
		padding: 22px 24px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.post-aside__section + .post-aside__section {
		border-top: 1px solid var(--border-subtle);
	}
	.post-aside__section--files {
		gap: 8px;
	}
	.post-aside__section--events {
		gap: 6px;
	}
	.post-aside__section--files .caption-title {
		margin-bottom: 4px;
	}
	.post-aside__section--events > .caption-title:first-child {
		margin-bottom: 6px;
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.post-tag {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		height: 32px;
		padding: 0 13px;
		border: 1px solid var(--border-default);
		border-radius: var(--radius-pill);
		background: var(--surface-card);
		font-size: 14px;
		font-weight: 600;
		color: var(--text-body);
		text-decoration: none;
	}
	.post-tag:hover {
		border-color: var(--border-strong);
		background: var(--bg-sunken);
		color: var(--text-body);
	}
	.post-tag span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}
	.post-file {
		padding: 10px 12px;
	}
	.post-file__icon {
		flex: none;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-md);
		background: var(--surface-brand-soft);
		color: var(--icon-brand);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.post-file__text {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.post-file__name {
		font-size: 15px;
		font-weight: 600;
		line-height: 1.35;
		color: var(--text-strong);
		overflow-wrap: anywhere;
	}
	.post-file__meta {
		font-size: 13px;
		color: var(--text-muted);
		overflow-wrap: anywhere;
	}
	.post-file__download {
		color: var(--icon-brand);
		display: flex;
	}
	.post-past-title {
		margin-top: 14px;
	}
	.post-past {
		display: flex;
		gap: 14px;
		align-items: baseline;
		padding: 10px 0;
		border-bottom: 1px solid var(--border-subtle);
		text-decoration: none;
		color: var(--text-muted);
	}
	.post-past:hover {
		color: var(--navy-700);
	}
	.post-past__date {
		flex: none;
		width: 56px;
		font-size: 14px;
		font-variant-numeric: tabular-nums;
	}
	.post-past__title {
		font-size: 15px;
		font-weight: 500;
	}
	.post-others {
		margin-top: var(--section-gap);
		padding-top: var(--section-gap);
		border-top: 1px solid var(--border-default);
	}
	.post-others__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 20px;
		margin-top: 32px;
	}
	@media (max-width: 859px) {
		.post-aside {
			position: static;
			max-width: none;
		}
	}
</style>
