---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import MassTimes from "../../components/ui/MassTimes.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { setCdnCache } from "../../lib/cache";
import { massPeriods, rosario, segreteria, vespri } from "../../data/parish";
import { sanityClient } from "../../sanity/lib/client";
import { formatWhenLong, sortTimes, todayInRome } from "../../sanity/lib/eventDate";
import { MASS_SPECIAL_DAY_FIELDS, type MassSpecialDay } from "../../sanity/lib/queries";

// Pagina generata a ogni richiesta: mostra i prossimi giorni con orari speciali
export const prerender = false;

setCdnCache(Astro.response.headers);

const specialDays = await sanityClient.fetch<MassSpecialDay[]>(
	`*[_type == "massSpecialDay" && date >= $today] | order(date asc)[0...6]{ ${MASS_SPECIAL_DAY_FIELDS} }`,
	{ today: todayInRome() },
);
---

<Layout
	title="Orari"
	description="Orari delle Sante Messe, vespri, rosario e apertura della segreteria della Parrocchia Santa Maria Addolorata."
>
	<Container class="page-top">
		<Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Info", href: "/info" }, { label: "Orari" }]} />
		<div class="orari-heading">
			<SectionHeading
				as="h1"
				size="lg"
				title="Orari delle Sante Messe"
				description="Gli orari delle celebrazioni variano nel corso dell'anno. Seleziona il periodo per vedere gli orari delle Sante Messe."
			/>
		</div>

		{
			specialDays.length > 0 && (
				<section class="special-days" aria-label="Orari speciali">
					<h2>Orari speciali</h2>
					<div class="mass-grid">
						{specialDays.map((day) => (
							<MassTimes title={formatWhenLong({ eventDate: day.date })} subtitle={day.note} icon="calendar" times={sortTimes(day.times)} />
						))}
					</div>
				</section>
			)
		}

		<div class="period-tabs" role="tablist" aria-label="Periodo dell'anno" data-periods>
			{
				massPeriods.map((p, i) => (
					<button
						type="button"
						role="tab"
						id={`tab-${p.id}`}
						aria-controls={`panel-${p.id}`}
						aria-selected={i === 0 ? "true" : "false"}
						data-period={p.id}
						data-months={p.months.join(",")}
					>
						<span>{p.label}</span>
						<span class="period-tabs__sub">{p.sublabel}</span>
					</button>
				))
			}
		</div>

		{
			massPeriods.map((p, i) => (
				<div role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0} data-panel={p.id}>
					<p class="period-range">{p.range}</p>
					<div class="mass-grid">
						<MassTimes title="Sante Messe festive" subtitle="Domenica e giorni festivi" icon="church" times={p.festive} />
						<MassTimes title="Sante Messe feriali" subtitle="Da lunedì a sabato" icon="clock" times={p.feriali} />
					</div>
				</div>
			))
		}

		<h2 class="all-year">Tutto l'anno</h2>
		<div class="mass-grid mass-grid--small">
			<MassTimes title="Rosario" subtitle="Tutti i giorni" icon="heart" times={rosario} />
			<MassTimes title="Vespri" subtitle="Tutti i giorni" icon="book-open" times={vespri} />
			<MassTimes title="Segreteria parrocchiale" subtitle={segreteria.days} icon="info" times={segreteria.times} />
		</div>
	</Container>
</Layout>

<script>
	const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-period]")];
	const select = (id: string) => {
		for (const tab of tabs) tab.setAttribute("aria-selected", String(tab.dataset.period === id));
		document.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
			panel.hidden = panel.dataset.panel !== id;
		});
	};
	tabs.forEach((tab) => tab.addEventListener("click", () => select(tab.dataset.period!)));
	// All'apertura si mostra il periodo in corso
	const month = new Date().getMonth() + 1;
	const current = tabs.find((t) => t.dataset.months!.split(",").map(Number).includes(month));
	if (current) select(current.dataset.period!);
</script>

<style>
	.orari-heading {
		margin-top: 24px;
	}
	.special-days {
		margin-top: 28px;
	}
	.special-days h2 {
		margin: 0;
		font: var(--type-h4);
		color: var(--text-strong);
	}
	.period-tabs {
		margin-top: 28px;
		display: inline-flex;
		flex-wrap: wrap;
		gap: 4px;
		padding: 4px;
		max-width: 100%;
		box-sizing: border-box;
		background: var(--bg-muted);
		border-radius: var(--radius-pill);
	}
	.period-tabs button {
		min-height: 46px;
		padding: 4px 16px;
		border: none;
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--text-muted);
		font-family: inherit;
		font-size: 14px;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		line-height: 1.15;
		transition:
			background var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}
	.period-tabs button:hover,
	.period-tabs button[aria-selected="true"] {
		color: var(--text-strong);
	}
	.period-tabs button[aria-selected="true"] {
		background: var(--surface-card);
		box-shadow: var(--shadow-sm);
	}
	.period-tabs__sub {
		font-size: 11.5px;
		font-weight: 500;
		color: var(--text-muted);
	}
	@media (max-width: 639px) {
		.period-tabs {
			display: grid;
			grid-template-columns: 1fr 1fr;
			width: 100%;
			border-radius: 24px;
		}
	}
	.period-range {
		margin: 24px 0 0;
		font-size: 16px;
		font-weight: 600;
		color: var(--text-strong);
	}
	.mass-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
		gap: 20px;
		margin-top: 16px;
	}
	.mass-grid--small {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
	}
	.all-year {
		margin: 48px 0 0;
		font: var(--type-h4);
		color: var(--text-strong);
	}
</style>
