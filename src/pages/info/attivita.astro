---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";

const groups = [
	"Azione Cattolica",
	"ACG - Azione Cattolica Giovani",
	"ACR - Azione Cattolica Ragazzi",
	"Caritas Vincenziana",
	"Catechismo Comunioni",
	"Catechismo Cresime",
	"Cresime Adulti",
	"Comunità Gesù Risorto",
	"Coro Adulti \"Dulcis Audire\"",
	"Coro Bambini",
	"Corso di Chitarra",
	"Giovani Famiglie",
	"Gruppi Giovanili",
	"Gruppo dei Lettori",
	"Gruppo Preghiera Padre Pio",
	"LAB Giovani",
	"Ministranti",
	"Ministri Straordinari della Comunione",
	"Oratorio",
	"Post Cresima",
	"Preparazione al Matrimonio",
];
---

<Layout
	title="Gruppi e attività"
	description="I gruppi, i cori e le attività della comunità della Parrocchia Santa Maria Addolorata."
>
	<Container class="page-top">
		<Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Info", href: "/info" }, { label: "Gruppi e attività" }]} />
		<div class="heading">
			<SectionHeading
				as="h1"
				size="lg"
				title="Gruppi e attività"
				description="La vita della parrocchia è animata da tanti gruppi e attività, aperti a chiunque voglia partecipare."
			/>
		</div>

		<ul class="groups">
			{
				groups.map((group) => (
					<li class="panel group">
						<span class="group__dot" />
						<span class="group__name">{group}</span>
					</li>
				))
			}
		</ul>
		<p class="groups-note">
			Per conoscere un gruppo o iniziare a partecipare potete <a href="/info/contatti">contattare la segreteria parrocchiale</a>.
		</p>
	</Container>
</Layout>

<style>
	.heading {
		margin-top: 24px;
	}
	.groups {
		list-style: none;
		margin: 32px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
		gap: 16px;
	}
	.group {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 18px 22px;
	}
	.group__dot {
		flex: none;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--teal-500);
	}
	.group__name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 19px;
		line-height: 1.25;
		color: var(--text-strong);
	}
	.groups-note {
		margin: 32px 0 0;
		font-size: 16px;
		color: var(--text-muted);
	}
</style>
