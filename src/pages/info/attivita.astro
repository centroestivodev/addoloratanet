---
import Layout from "../../layouts/Layout.astro";

const groups = [
	"Azione Cattolica",
	"ACG - Azione Cattolica Giovani",
	"ACR - Azione Cattolica Ragazzi",
	"Caritas Vincenziana",
	"Catechismo Comunioni",
	"Catechismo Cresime",
	"Cresime Adulti",
	"Comunità Gesù Risorto",
	"Coro Adulti \"Dulcis Audire\"",
	"Coro Bambini",
	"Corso di Chitarra",
	"Giovani Famiglie",
	"Gruppi Giovanili",
	"Gruppo dei Lettori",
	"Gruppo Preghiera Padre Pio",
	"LAB Giovani",
	"Ministranti",
	"Ministri Straordinari della Comunione",
	"Oratorio",
	"Post Cresima",
	"Preparazione al Matrimonio",
];
---

<Layout>
	<div class="w-8/12 mx-auto py-12">
		<h1 class="text-3xl font-bold mb-2">Gruppi e attività</h1>
		<p class="text-base-content/70 mb-10">
			La vita della parrocchia è animata da tanti gruppi e attività, aperti a chiunque voglia
			partecipare.
		</p>

		<ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
			{
				groups.map((group) => (
					<li class="card bg-base-200">
						<div class="card-body py-4 px-5">
							<span class="font-medium">{group}</span>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</Layout>
