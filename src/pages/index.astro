---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import NewsCard from "../components/NewsCard.astro";
import NewsHero from "../components/NewsHero.astro";
import MediaCard from "../components/MediaCard.astro";
import EventCardRow from "../components/EventCard.astro";
import TodayInParish from "../components/TodayInParish.astro";
import Icon from "../components/ui/Icon.astro";
import IconButton from "../components/ui/IconButton.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import TextLink from "../components/ui/TextLink.astro";
import DateBadge from "../components/ui/DateBadge.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/images/hero/01.jpeg";
import { setCdnCache } from "../lib/cache";
import { sanityClient } from "../sanity/lib/client";
import { urlFor } from "../sanity/lib/image";
import { formatCardTime, formatWhenShort, sortTimes, todayInRome, todayItems, type RecurringEvent } from "../sanity/lib/eventDate";
import {
	EVENT_CARD_FIELDS,
	EVENT_TODAY_FIELDS,
	MASS_SPECIAL_DAY_FIELDS,
	POST_CARD_FIELDS,
	PUBLISHED_POST,
	RECURRING_EVENTS,
	type EventCard,
	type EventToday,
	type MassSpecialDay,
	type PostCard,
} from "../sanity/lib/queries";
import { massPeriodFor, socials } from "../data/parish";

// Pagina generata a ogni richiesta: "oggi" è la data della visita, non della build.
export const prerender = false;

// Netlify tiene in cache la pagina, così non si interroga Sanity a ogni visita
setCdnCache(Astro.response.headers);

const today = todayInRome();

// Prossimi eventi (compresi quelli di più giorni ancora in corso) e ultime notizie
const { events, eventsToday, posts, recurring, specialDay } = await sanityClient.fetch<{
	events: EventCard[];
	eventsToday: EventToday[];
	posts: PostCard[];
	recurring: RecurringEvent[];
	specialDay: MassSpecialDay | null;
}>(
	`{
		"events": *[_type == "event" && defined(slug.current) && coalesce(endDate, eventDate) >= $today]
			| order(eventDate asc, startTime asc)[0...5]{ ${EVENT_CARD_FIELDS} },
		"posts": *[_type == "post" && defined(slug.current) && ${PUBLISHED_POST}]
			| order(coalesce(publishedAt, _createdAt) desc)[0...9]{ ${POST_CARD_FIELDS} },
		"eventsToday": *[_type == "event" && defined(slug.current) && eventDate <= $today && coalesce(endDate, eventDate) >= $today]{ ${EVENT_TODAY_FIELDS} },
		"recurring": ${RECURRING_EVENTS},
		"specialDay": *[_type == "massSpecialDay" && date == $today] | order(_updatedAt desc)[0]{ ${MASS_SPECIAL_DAY_FIELDS} }
	}`,
	{ today },
);

const quickLinks = [
	{ href: "/info/orari", icon: "clock", label: "Orari delle Messe", description: "Feriali e festivi" },
	{ href: "/eventi", icon: "calendar-days", label: "Calendario", description: "Incontri, feste, percorsi" },
	{ href: "/info/dove-siamo", icon: "map-pin", label: "Dove siamo", description: "Viale della Venezia Giulia 134" },
] as const;

// Desktop: 2 eventi grandi + 3 piccoli. Telefono: 1 grande + 2 piccoli.
// Notizie: la prima a tutta larghezza, poi 2; sotto "Altre notizie" ne mostra 6.
const bigEvents = events.slice(0, 2);
const smallEvents = events.slice(1, 5);
const newsHero = posts[0];
const newsSecond = posts.slice(1, 3);
const newsOthers = posts.slice(3, 9);

// Sante Messe di oggi: quelle del giorno speciale, se c'è, altrimenti secondo il periodo dell'anno
const [y, m, d] = today.split("-").map(Number);
const todayDate = new Date(Date.UTC(y, m - 1, d));
const period = massPeriodFor(m);
const isSunday = todayDate.getUTCDay() === 0;
const todayTimes = specialDay ? sortTimes(specialDay.times) : isSunday ? period.festive : period.feriali;
const todayLabel = new Intl.DateTimeFormat("it-IT", { weekday: "long", day: "numeric", month: "long", timeZone: "UTC" }).format(todayDate);

---

<Layout description="Parrocchia Santa Maria Addolorata a Roma: orari delle messe, avvisi, notizie e attività della comunità parrocchiale.">
	<section class="hero">
		<Image
			src={heroImage}
			widths={[640, 1024, 1600, 2000]}
			sizes="100vw"
			format="webp"
			quality={75}
			alt=""
			class="hero__image"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero__overlay"></div>
		<div class="hero__content">
			<SectionHeading as="h1" size="xl" onDark align="center" title="Parrocchia" accent="Santa Maria Addolorata" />
			<div class="hero__today">
				<span class="hero__today-label">Sante Messe di oggi, {todayLabel}</span>
				<div class="hero__times">
					{todayTimes.map((t) => <span>{t}</span>)}
				</div>
				{specialDay?.note && <span class="hero__today-note">{specialDay.note}</span>}
				<TextLink href="/info/orari" tone="onDark">Tutti gli orari</TextLink>
			</div>
		</div>
	</section>

	<div class="quick-links-wrap">
		<nav aria-label="Collegamenti rapidi" class="quick-links">
			{
				quickLinks.map((q) => (
					<a href={q.href} class="quick-links__cell">
						<span class="quick-links__icon">
							<Icon name={q.icon} size={30} strokeWidth={1.75} />
						</span>
						<span class="quick-links__label">{q.label}</span>
						<span class="quick-links__desc">{q.description}</span>
					</a>
				))
			}
		</nav>
		<div class="recurring-today-wrap">
			<TodayInParish items={todayItems(recurring, eventsToday, today)} />
		</div>
	</div>

	{
		(posts.length > 0 || events.length > 0) && (
			<Container class="home-section">
				<div class="home-grid">
					{posts.length > 0 && (
						<section class="home-news">
							<SectionHeading title="Ultime notizie" />
							<NewsHero post={newsHero} />
							{newsSecond.length > 0 && (
								<div class="news-pair">
									{newsSecond.map((post) => (
										<NewsCard post={post} class="only-desk" />
										<NewsCard post={post} layout="row" class="only-mob" />
									))}
								</div>
							)}
						</section>
					)}

					{events.length > 0 && (
						<aside class="home-events">
							<SectionHeading title="Appuntamenti" />
							{bigEvents.map((ev, i) => (
								<MediaCard
									href={`/eventi/${ev.slug}`}
									title={ev.title}
									image={ev.image?.asset ? { src: urlFor(ev.image).width(360).auto("format").url(), alt: ev.image.alt || "" } : undefined}
									placeholder="calendar-days"
									class={i === 1 ? "only-desk event-big" : "event-big"}
								>
									<div class="event-big__when-row">
										<DateBadge date={ev.eventDate} tone="navy" />
										<span class="event-big__when">
											<Icon name="clock" size={16} color="var(--icon-brand)" />
											{formatWhenShort(ev)}
										</span>
									</div>
								</MediaCard>
							))}
							{smallEvents.length > 0 && (
								<div class="events-small">
									{smallEvents.map((ev, i) => (
										<EventCardRow
											event={ev}
											compact
											class:list={[{ "only-mob": i === 0, "only-desk": i >= 2 }]}
										/>
									))}
								</div>
							)}
							<div>
								<TextLink href="/eventi">Vedi il calendario</TextLink>
							</div>
						</aside>
					)}
				</div>
			</Container>
		)
	}

	{
		newsOthers.length > 0 && (
			<Container class="home-section">
				<SectionHeading title="Altre notizie" />
				<div class="news-others">
					{newsOthers.map((post) => (
						<NewsCard post={post} class="only-desk" excerpt={false} />
						<NewsCard post={post} layout="row" class="only-mob" />
					))}
				</div>
				<div class="news-more">
					<TextLink href="/notizie">Tutte le notizie</TextLink>
				</div>
			</Container>
		)
	}

	<Container class="home-section">
		<div class="follow">
			<span class="follow__label">Seguici</span>
			<div class="follow__icons">
				{socials.map((s) => <IconButton icon={s.icon} label={s.name} variant="brand" size="lg" href={s.href} external />)}
			</div>
		</div>
	</Container>
</Layout>

<style>
	.hero {
		position: relative;
		height: min(72vh, 600px);
		min-height: 460px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		text-align: center;
		background: var(--navy-800);
	}
	.hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
	}
	.hero__overlay {
		position: absolute;
		inset: 0;
		background: var(--overlay-hero);
	}
	.hero__content {
		position: relative;
		padding: 0 24px 56px;
		max-width: 980px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.hero__today {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 12px 16px;
		margin-top: 32px;
		color: var(--text-on-dark);
	}
	.hero__today-label {
		font-size: 15px;
		font-weight: 600;
	}
	.hero__today-note {
		font-size: 15px;
		font-style: italic;
	}
	.hero__times {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px;
	}
	.hero__times span {
		background: var(--stone-0);
		color: var(--navy-700);
		font-weight: 700;
		font-size: 16px;
		font-variant-numeric: tabular-nums;
		padding: 5px 10px;
		border-radius: var(--radius-sm);
		line-height: 1.2;
	}

	.quick-links-wrap {
		position: relative;
		z-index: 2;
		max-width: 920px;
		margin: -64px auto 0;
		padding: 0 var(--container-pad);
		box-sizing: border-box;
	}
	.quick-links {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		background: var(--surface-card);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		border: 1px solid var(--border-subtle);
		overflow: hidden;
	}
	.quick-links__cell {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 24px 16px 22px;
		text-decoration: none;
		text-align: center;
		color: var(--text-strong);
		transition: background var(--dur-base) var(--ease-out);
	}
	.quick-links__cell + .quick-links__cell {
		border-left: 1px solid var(--border-subtle);
	}
	.quick-links__cell:hover {
		background: var(--surface-brand-soft);
		color: var(--text-strong);
	}
	.quick-links__icon {
		color: var(--icon-brand);
		display: flex;
		transition: transform var(--dur-base) var(--ease-out);
	}
	.quick-links__cell:hover .quick-links__icon {
		transform: translateY(-2px);
	}
	.quick-links__label {
		font-weight: 600;
		font-size: 17px;
	}
	.quick-links__desc {
		font-size: 13.5px;
		color: var(--text-muted);
		line-height: 1.4;
	}
	@media (max-width: 639px) {
		.quick-links__cell {
			gap: 8px;
			padding: 18px 6px 16px;
		}
		.quick-links__icon :global(svg) {
			width: 26px;
			height: 26px;
		}
		.quick-links__label {
			font-size: 14px;
			line-height: 1.25;
			text-wrap: balance;
		}
		.quick-links__desc {
			display: none;
		}
	}

	.recurring-today-wrap {
		margin-top: 12px;
	}
	:global(.home-section) {
		margin-top: var(--section-gap);
	}
	.home-grid {
		display: grid;
		gap: 48px;
	}
	.home-news,
	.home-events {
		display: flex;
		flex-direction: column;
		gap: 24px;
		min-width: 0;
	}
	.home-news :global(.news-hero) {
		flex: 1 0 auto;
	}
	.news-pair {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		gap: 24px;
	}
	.news-others {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		gap: 24px;
		margin-top: 24px;
	}
	.news-more {
		display: flex;
		justify-content: center;
		margin-top: 28px;
	}
	@media (min-width: 960px) {
		.home-grid {
			grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
			gap: 40px;
		}
		.home-grid {
			align-items: stretch;
		}
		.news-pair {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.event-big__when-row {
		display: flex;
		align-items: center;
		gap: 10px;
		padding-top: 12px;
		border-top: 1px solid var(--border-subtle);
	}
	.event-big__when {
		display: flex;
		align-items: center;
		gap: 6px;
		min-width: 0;
		font-size: 14px;
		font-weight: 600;
		line-height: 1.35;
		color: var(--text-strong);
	}
	.events-small {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	@media (min-width: 960px) {
		.home-events :global(.event-big),
		.events-small {
			flex: 1 1 auto;
		}
		.events-small :global(.event-card) {
			flex: 1 1 auto;
		}
	}

	.follow {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		padding: 36px 24px;
		border-top: 1px solid var(--border-default);
		border-bottom: 1px solid var(--border-default);
	}
	.follow__label {
		font-size: 14px;
		font-weight: 600;
		color: var(--text-muted);
	}
	.follow__icons {
		display: flex;
		gap: 12px;
	}
</style>
