---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import NewsCard from "../components/NewsCard.astro";
import EventCardRow from "../components/EventCard.astro";
import Icon from "../components/ui/Icon.astro";
import IconButton from "../components/ui/IconButton.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import TextLink from "../components/ui/TextLink.astro";
import DateBadge from "../components/ui/DateBadge.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/images/hero/01.jpeg";
import { sanityClient } from "sanity:client";
import { urlFor } from "../sanity/lib/image";
import { formatCardTime, formatWhenShort, todayInRome } from "../sanity/lib/eventDate";
import { EVENT_CARD_FIELDS, POST_CARD_FIELDS, type EventCard, type PostCard } from "../sanity/lib/queries";
import { massPeriodFor, socials } from "../data/parish";

// Pagina generata a ogni richiesta: "oggi" è la data della visita, non della build.
export const prerender = false;

// Netlify tiene in cache la pagina per 5 minuti, così non si interroga Sanity a ogni visita
Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
Astro.response.headers.set("Netlify-CDN-Cache-Control", "public, durable, s-maxage=300, stale-while-revalidate=3600");

const today = todayInRome();

// Prossimi eventi (compresi quelli di più giorni ancora in corso) e ultime notizie
const { events, posts } = await sanityClient.fetch<{ events: EventCard[]; posts: PostCard[] }>(
	`{
		"events": *[_type == "event" && defined(slug.current) && coalesce(endDate, eventDate) >= $today]
			| order(eventDate asc, startTime asc)[0...6]{ ${EVENT_CARD_FIELDS} },
		"posts": *[_type == "post" && defined(slug.current)]
			| order(coalesce(publishedAt, _createdAt) desc)[0...5]{ ${POST_CARD_FIELDS} }
	}`,
	{ today },
);

const featured = events.slice(0, 2);
const others = events.slice(2, 6);
const newsBig = posts.slice(0, 2);
const newsSmall = posts.slice(2, 5);

// SS. Messe di oggi, secondo il periodo dell'anno
const [y, m, d] = today.split("-").map(Number);
const todayDate = new Date(Date.UTC(y, m - 1, d));
const period = massPeriodFor(m);
const isSunday = todayDate.getUTCDay() === 0;
const todayTimes = isSunday ? period.festive : period.feriali;
const todayLabel = new Intl.DateTimeFormat("it-IT", { weekday: "long", day: "numeric", month: "long", timeZone: "UTC" }).format(todayDate);

const quickLinks = [
	{ href: "/info/orari", icon: "clock", label: "Orari delle Messe", description: "Feriali e festivi" },
	{ href: "/eventi", icon: "calendar-days", label: "Calendario", description: "Incontri, feste, percorsi" },
	{ href: "/info/dove-siamo", icon: "map-pin", label: "Dove siamo", description: "V.le della Venezia Giulia 134" },
] as const;

// Le locandine verticali si mostrano intere, le foto si ritagliano
function featuredImage(event: EventCard) {
	if (!event.image?.asset) return undefined;
	const dims = event.imageDimensions;
	const isPoster = dims ? dims.height / dims.width > 1.3 : false;
	return {
		src: isPoster ? urlFor(event.image).width(440).auto("format").url() : urlFor(event.image).width(440).height(586).auto("format").url(),
		fit: isPoster ? "contain" : "cover",
		alt: event.image.alt || "",
	};
}
---

<Layout description="Parrocchia Santa Maria Addolorata a Roma: orari delle messe, avvisi, notizie e attività della comunità parrocchiale.">
	<section class="hero">
		<Image
			src={heroImage}
			widths={[640, 1024, 1600, 2000]}
			sizes="100vw"
			format="webp"
			quality={75}
			alt=""
			class="hero__image"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero__overlay"></div>
		<div class="hero__content">
			<SectionHeading as="h1" size="xl" onDark align="center" eyebrow="Benvenuti" title="Parrocchia" accent="Santa Maria Addolorata" />
			<div class="hero__today">
				<span class="hero__today-label">SS. Messe di oggi, {todayLabel}</span>
				<div class="hero__times">
					{todayTimes.map((t) => <span>{t}</span>)}
				</div>
				<TextLink href="/info/orari" tone="onDark">Tutti gli orari</TextLink>
			</div>
		</div>
	</section>

	<div class="quick-links-wrap">
		<nav aria-label="Collegamenti rapidi" class="quick-links">
			{
				quickLinks.map((q) => (
					<a href={q.href} class="quick-links__cell">
						<span class="quick-links__icon">
							<Icon name={q.icon} size={30} strokeWidth={1.75} />
						</span>
						<span class="quick-links__label">{q.label}</span>
						<span class="quick-links__desc">{q.description}</span>
					</a>
				))
			}
		</nav>
	</div>

	{
		events.length > 0 && (
			<Container class="home-section">
				<div class="section-head">
					<SectionHeading eyebrow="Calendario" title="Prossimi appuntamenti" />
					<TextLink href="/eventi">Vedi il calendario</TextLink>
				</div>

				{/* Mobile: elenco compatto */}
				<div class="events-mob only-mob">
					{featured.map((ev) => (
						<a href={`/eventi/${ev.slug}`} class="event-compact">
							<DateBadge date={ev.eventDate} tone="navy" showWeekday />
							<div class="event-compact__body">
								<h3 class="event-compact__title event-compact__title--lg">{ev.title}</h3>
								<span class="event-compact__when">{formatWhenShort(ev)}</span>
								<p class="event-compact__desc clamp-2">{ev.description}</p>
							</div>
						</a>
					))}
					{others.map((ev) => (
						<a href={`/eventi/${ev.slug}`} class="event-compact event-compact--center">
							<DateBadge date={ev.eventDate} size="sm" />
							<div class="event-compact__body event-compact__body--tight">
								<h3 class="event-compact__title">{ev.title}</h3>
								{formatCardTime(ev) && <span class="event-compact__time">{formatCardTime(ev)}</span>}
							</div>
							<span class="event-compact__chevron">
								<Icon name="chevron-right" size={18} />
							</span>
						</a>
					))}
				</div>

				{/* Desktop: in evidenza a sinistra, gli altri a destra */}
				<div class="events-desk only-desk">
					<div class="events-desk__col">
						{featured.map((ev) => {
							const img = featuredImage(ev);
							return (
								<a href={`/eventi/${ev.slug}`} class="featured-event">
									<div class="featured-event__media">
										{img ? (
											<img src={img.src} alt={img.alt} loading="lazy" decoding="async" style={{ objectFit: img.fit }} />
										) : (
											<span class="featured-event__placeholder">
												<Icon name="calendar-days" size={36} strokeWidth={1.5} />
											</span>
										)}
									</div>
									<div class="featured-event__body">
										<h3 class="featured-event__title">{ev.title}</h3>
										<div class="featured-event__when-row">
											<DateBadge date={ev.eventDate} tone="navy" showWeekday />
											<span class="featured-event__when">
												<Icon name="clock" size={16} color="var(--icon-brand)" />
												{formatWhenShort(ev)}
											</span>
										</div>
										<p class="featured-event__desc clamp-4">{ev.description}</p>
									</div>
								</a>
							);
						})}
					</div>
					{others.length > 0 && (
						<div class="events-desk__col events-desk__col--list">
							{others.map((ev) => (
								<EventCardRow event={ev} class="events-desk__row" />
							))}
						</div>
					)}
				</div>
			</Container>
		)
	}

	{
		posts.length > 0 && (
			<Container class="home-section">
				<SectionHeading align="center" ornament title="Ultime notizie e avvisi" />
				<div class="news-big">
					{newsBig.map((post) => (
						<NewsCard post={post} />
					))}
				</div>
				{newsSmall.length > 0 && (
					<div class="news-small">
						{newsSmall.map((post) => (
							<NewsCard post={post} excerpt={false} />
						))}
					</div>
				)}
				<div class="news-more">
					<TextLink href="/notizie">Tutte le notizie</TextLink>
				</div>
			</Container>
		)
	}

	<Container class="home-section">
		<div class="follow">
			<span class="eyebrow">Seguici</span>
			<div class="follow__icons">
				{socials.map((s) => <IconButton icon={s.icon} label={s.name} variant="brand" size="lg" href={s.href} external />)}
			</div>
		</div>
	</Container>
</Layout>

<style>
	.hero {
		position: relative;
		height: min(72vh, 600px);
		min-height: 460px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		text-align: center;
		background: var(--navy-800);
	}
	.hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
	}
	.hero__overlay {
		position: absolute;
		inset: 0;
		background: var(--overlay-hero);
	}
	.hero__content {
		position: relative;
		padding: 0 24px 56px;
		max-width: 980px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.hero__today {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 12px 16px;
		margin-top: 32px;
		color: var(--text-on-dark);
	}
	.hero__today-label {
		font-size: 15px;
		font-weight: 600;
	}
	.hero__times {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px;
	}
	.hero__times span {
		background: var(--stone-0);
		color: var(--navy-700);
		font-weight: 700;
		font-size: 16px;
		font-variant-numeric: tabular-nums;
		padding: 5px 10px;
		border-radius: var(--radius-sm);
		line-height: 1.2;
	}

	.quick-links-wrap {
		position: relative;
		z-index: 2;
		max-width: 920px;
		margin: -64px auto 0;
		padding: 0 var(--container-pad);
		box-sizing: border-box;
	}
	.quick-links {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		background: var(--surface-card);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		border: 1px solid var(--border-subtle);
		overflow: hidden;
	}
	.quick-links__cell {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 24px 16px 22px;
		text-decoration: none;
		text-align: center;
		color: var(--text-strong);
		transition: background var(--dur-base) var(--ease-out);
	}
	.quick-links__cell + .quick-links__cell {
		border-left: 1px solid var(--border-subtle);
	}
	.quick-links__cell:hover {
		background: var(--surface-brand-soft);
		color: var(--text-strong);
	}
	.quick-links__icon {
		color: var(--icon-brand);
		display: flex;
		transition: transform var(--dur-base) var(--ease-out);
	}
	.quick-links__cell:hover .quick-links__icon {
		transform: translateY(-2px);
	}
	.quick-links__label {
		font-weight: 600;
		font-size: 17px;
	}
	.quick-links__desc {
		font-size: 13.5px;
		color: var(--text-muted);
		line-height: 1.4;
	}
	@media (max-width: 639px) {
		.quick-links__cell {
			gap: 8px;
			padding: 18px 6px 16px;
		}
		.quick-links__icon :global(svg) {
			width: 26px;
			height: 26px;
		}
		.quick-links__label {
			font-size: 14px;
			line-height: 1.25;
			text-wrap: balance;
		}
		.quick-links__desc {
			display: none;
		}
	}

	:global(.home-section) {
		margin-top: var(--section-gap);
	}
	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.events-mob {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-top: 20px;
	}
	.event-compact {
		display: flex;
		gap: 14px;
		align-items: flex-start;
		padding: 14px;
		border-radius: var(--radius-lg);
		background: var(--surface-card);
		border: 1px solid var(--border-subtle);
		box-shadow: var(--shadow-sm);
		color: inherit;
		text-decoration: none;
	}
	.event-compact--center {
		align-items: center;
	}
	.event-compact__body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 5px;
	}
	.event-compact__body--tight {
		gap: 4px;
	}
	.event-compact__title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 17px;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--text-strong);
		text-wrap: pretty;
	}
	.event-compact__title--lg {
		font-size: 18px;
		line-height: 1.22;
	}
	.event-compact__when {
		font-size: 13px;
		font-weight: 600;
		color: var(--text-brand);
	}
	.event-compact__time {
		font-size: 13px;
		color: var(--text-muted);
	}
	.event-compact__desc {
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
		color: var(--text-body);
	}
	.event-compact__chevron {
		flex: none;
		color: var(--text-subtle);
		display: flex;
	}

	.events-desk {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
		gap: 20px;
		margin-top: 28px;
		align-items: stretch;
	}
	.events-desk__col {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.events-desk__col--list {
		gap: 12px;
	}
	.events-desk__col--list :global(.events-desk__row) {
		flex: 1;
	}
	.featured-event {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		align-items: flex-start;
		padding: 20px;
		border-radius: var(--radius-lg);
		background: var(--surface-card);
		border: 1px solid var(--border-subtle);
		box-shadow: var(--shadow-sm);
		color: inherit;
		text-decoration: none;
		transition:
			box-shadow var(--dur-base) var(--ease-out),
			transform var(--dur-base) var(--ease-out);
	}
	.featured-event:hover {
		color: inherit;
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}
	.featured-event__media {
		flex: 1 1 170px;
		max-width: 220px;
		min-height: 120px;
		background: var(--bg-muted);
		border-radius: var(--radius-md);
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.featured-event__media img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		transition: transform var(--dur-slow) var(--ease-out);
	}
	.featured-event:hover .featured-event__media img {
		transform: scale(1.03);
	}
	.featured-event__placeholder {
		color: var(--stone-400);
		display: flex;
	}
	.featured-event__body {
		flex: 1 1 240px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		min-width: 0;
	}
	.featured-event__title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 24px;
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--text-strong);
		text-wrap: balance;
	}
	.featured-event__when-row {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 12px 0;
		border-top: 1px solid var(--border-subtle);
		border-bottom: 1px solid var(--border-subtle);
	}
	.featured-event__when {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 15px;
		font-weight: 600;
		line-height: 1.35;
		color: var(--text-strong);
		text-wrap: pretty;
	}
	.featured-event__desc {
		margin: 0;
		font-size: 15px;
		line-height: 1.6;
		color: var(--text-body);
	}

	.news-big {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
		gap: 20px;
		margin-top: 32px;
	}
	.news-small {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		gap: 20px;
		margin-top: 20px;
	}
	.news-more {
		display: flex;
		justify-content: center;
		margin-top: 28px;
	}

	.follow {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		padding: 36px 24px;
		border-top: 1px solid var(--border-default);
		border-bottom: 1px solid var(--border-default);
	}
	.follow__icons {
		display: flex;
		gap: 12px;
	}
</style>
