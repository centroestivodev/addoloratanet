---
import Layout from '../layouts/Layout.astro';
import ChurchIcon from '../assets/icons/church.svg';
import NewspaperIcon from '../assets/icons/newspaper.svg';
import HandshakeIcon from '../assets/icons/handshake.svg';
import ClockIcon from '../assets/icons/clock.svg';
import MapPinIcon from '../assets/icons/map-pin.svg';
import HeroIcon from '../components/HeroIcon.astro';
import Container from '../components/Container.astro';
import HeroImg from '../assets/images/hero.jpeg';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../sanity/lib/image';
import { truncate } from '../sanity/lib/text';

interface Event {
	_id: string;
	title: string;
	slug: string;
	description: string;
	image?: any;
	eventDate: string;
}

const latestEvents = await sanityClient.fetch<Event[]>(
	`*[_type == "event" && defined(slug.current)] | order(eventDate desc)[0...3]{
		_id, title, "slug": slug.current, description, image, eventDate
	}`
);

const dateFormatter = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });

const highlights = [
	{
		href: '/info/orari',
		title: 'Orari delle Messe',
		description: 'Consulta gli orari delle celebrazioni e della segreteria parrocchiale.',
		Icon: ClockIcon,
	},
	{
		href: '/info/dove-siamo',
		title: 'Dove siamo',
		description: 'V.le della Venezia Giulia 134, Roma. Vieni a trovarci.',
		Icon: MapPinIcon,
	},
	{
		href: '/avvisi',
		title: 'Ultimi avvisi',
		description: 'Resta aggiornato su eventi, iniziative e comunicazioni della parrocchia.',
		Icon: NewspaperIcon,
	},
];
---

<Layout>
	<section
		class="hero min-h-[65vh] sm:min-h-[75vh] relative"
		style={`background-image: url(${HeroImg.src}); background-position: center 30%;`}
	>
		<div class="hero-overlay bg-gradient-to-t from-black/80 via-black/40 to-black/10"></div>
		<div class="hero-content text-center px-4">
			<div class="max-w-2xl flex flex-col items-center gap-8">
				<div>
					<p class="uppercase tracking-widest text-xs sm:text-sm text-white/70 mb-2">Benvenuti</p>
					<h1 class="text-3xl sm:text-5xl font-bold text-white">Parrocchia Santa Maria Addolorata</h1>
					<p class="mt-4 text-base sm:text-lg text-white/90">
						Una comunità che accoglie, celebra e cammina insieme, nel cuore di Roma.
					</p>
				</div>

				<div class="grid grid-cols-3 gap-4 sm:gap-8 w-full max-w-xl">
					<HeroIcon text="La parrocchia" href="/info">
						<ChurchIcon class="h-full w-full" />
					</HeroIcon>
					<HeroIcon text="Notizie e avvisi" href="/avvisi">
						<NewspaperIcon class="h-full w-full" />
					</HeroIcon>
					<HeroIcon text="Sostienici" href="/sostienici">
						<HandshakeIcon class="h-full w-full" />
					</HeroIcon>
				</div>
			</div>
		</div>
	</section>

	<Container class="py-16">
		<div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
			{
				highlights.map(({ href, title, description, Icon }) => (
					<a href={href} class="card bg-base-200 hover:shadow-lg transition-shadow">
						<div class="card-body">
							<div class="h-8 w-8 text-primary mb-1">
								<Icon class="h-full w-full" />
							</div>
							<h2 class="card-title">{title}</h2>
							<p class="text-base-content/70">{description}</p>
						</div>
					</a>
				))
			}
		</div>
	</Container>

	{
		latestEvents.length > 0 && (
			<Container class="pb-16">
				<div class="flex items-baseline justify-between mb-6">
					<h2 class="text-2xl font-bold">Ultime notizie</h2>
					<a href="/avvisi" class="link link-hover text-primary text-sm shrink-0 ml-4">
						Vedi tutti gli avvisi →
					</a>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
					{latestEvents.map((event) => (
						<a
							href={`/avvisi/${event.slug}`}
							class="card bg-base-200 hover:shadow-lg transition-shadow overflow-hidden"
						>
							{event.image && (
								<figure class="aspect-video">
									<img
										src={urlFor(event.image).width(600).height(340).auto('format').url()}
										alt=""
										class="w-full h-full object-cover"
									/>
								</figure>
							)}
							<div class="card-body">
								<span class="text-xs text-base-content/60">
									{dateFormatter.format(new Date(event.eventDate))}
								</span>
								<h3 class="card-title">{event.title}</h3>
								<p class="text-base-content/70">{truncate(event.description)}</p>
							</div>
						</a>
					))}
				</div>
			</Container>
		)
	}
</Layout>
