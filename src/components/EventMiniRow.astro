---
// Appuntamento nelle colonne laterali: data piccola, titolo e orario
import DateBadge from "./ui/DateBadge.astro";
import { formatCardTime } from "../sanity/lib/eventDate";
import type { EventSchedule } from "../sanity/lib/eventDate";

interface Props {
	event: EventSchedule & { title: string; slug: string };
}

const { event } = Astro.props;
const time = formatCardTime(event);
---

<a href={`/eventi/${event.slug}`} class="row-link">
	<DateBadge date={event.eventDate} size="sm" />
	<span class="mini-row__text">
		<span class="mini-row__title">{event.title}</span>
		{time && <span class="mini-row__time">{time}</span>}
	</span>
</a>

<style>
	.mini-row__text {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 3px;
	}
	.mini-row__title {
		font-size: 15px;
		font-weight: 600;
		line-height: 1.3;
		color: var(--text-strong);
		text-wrap: pretty;
	}
	.mini-row__time {
		font-size: 13px;
		color: var(--text-muted);
	}
</style>
