---
import Icon from "./Icon.astro";
import type { IconName } from "./icons";

interface Props {
	title: string;
	subtitle?: string;
	times: string[];
	icon?: IconName;
}

const { title, subtitle, times, icon = "church" } = Astro.props;
---

<div class="mass-times">
	<div class="mass-times__head">
		<span class="mass-times__icon"><Icon name={icon} size={20} /></span>
		<div class="mass-times__titles">
			<h3>{title}</h3>
			{subtitle && <span>{subtitle}</span>}
		</div>
	</div>
	{
		times.length > 0 && (
			<ul>
				{times.map((time) => (
					<li>{time}</li>
				))}
			</ul>
		)
	}
</div>

<style>
	.mass-times {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 24px;
		border-radius: var(--radius-lg);
		background: var(--surface-card);
		border: 1px solid var(--border-subtle);
		box-shadow: var(--shadow-sm);
		font-family: var(--font-sans);
		box-sizing: border-box;
	}
	.mass-times__head {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.mass-times__icon {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--teal-50);
		color: var(--icon-brand);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.mass-times__titles {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}
	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 20px;
		line-height: 1.2;
		color: var(--text-strong);
	}
	.mass-times__titles span {
		font-size: 14px;
		color: var(--text-muted);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	li {
		display: inline-flex;
		justify-content: center;
		min-width: 64px;
		height: 40px;
		line-height: 40px;
		padding: 0 14px;
		border-radius: var(--radius-sm);
		background: var(--bg-sunken);
		color: var(--navy-700);
		font-weight: 700;
		font-size: 17px;
		font-variant-numeric: tabular-nums;
		box-sizing: border-box;
	}
</style>
