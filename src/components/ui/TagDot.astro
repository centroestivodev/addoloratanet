---
// Pallino colorato del tag, seguito dal nome
interface Props {
	name: string;
	color?: string;
	size?: number;
}

const { name, color, size = 8 } = Astro.props;
---

<span class="tag-dot">
	<span class="tag-dot__dot" style={{ width: `${size}px`, height: `${size}px`, background: color || "var(--stone-400)" }}></span>
	{name}
</span>

<style>
	.tag-dot {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.tag-dot__dot {
		border-radius: 50%;
		flex-shrink: 0;
	}
</style>
