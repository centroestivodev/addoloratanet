---
// Schede di navigazione fatte di link: ogni scheda porta a un URL (filtri, viste)
interface Item {
	label: string;
	href: string;
	sublabel?: string;
	active?: boolean;
}

interface Props {
	items: Item[];
	variant?: "pill" | "underline";
	label: string;
	class?: string;
}

const { items, variant = "pill", label, class: className } = Astro.props;
---

<nav aria-label={label} class:list={["tabs-ds", `tabs-ds--${variant}`, className]}>
	{
		items.map((item) => (
			<a href={item.href} class:list={["tabs-ds__item", { "is-active": item.active }]} aria-current={item.active ? "page" : undefined}>
				<span>{item.label}</span>
				{item.sublabel && <span class="tabs-ds__sublabel">{item.sublabel}</span>}
			</a>
		))
	}
</nav>

<style>
	.tabs-ds {
		display: inline-flex;
		flex-wrap: wrap;
		max-width: 100%;
		box-sizing: border-box;
		font-family: var(--font-sans);
	}
	.tabs-ds--pill {
		gap: 4px;
		padding: 4px;
		background: var(--bg-muted);
		border-radius: var(--radius-pill);
	}
	.tabs-ds--underline {
		gap: 24px;
		border-bottom: 1px solid var(--border-default);
	}
	.tabs-ds__item {
		font-weight: 600;
		white-space: nowrap;
		text-decoration: none;
		color: var(--text-muted);
		transition:
			background var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}
	.tabs-ds__item:hover,
	.tabs-ds__item.is-active {
		color: var(--text-strong);
	}
	.tabs-ds--pill .tabs-ds__item {
		min-height: 38px;
		padding: 0 16px;
		border-radius: var(--radius-pill);
		font-size: 14px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		line-height: 1.15;
	}
	.tabs-ds--pill .tabs-ds__item.is-active {
		background: var(--surface-card);
		box-shadow: var(--shadow-sm);
	}
	.tabs-ds--underline .tabs-ds__item {
		padding: 10px 0 12px;
		margin-bottom: -1px;
		border-bottom: 2px solid transparent;
		font-size: 15px;
	}
	.tabs-ds--underline .tabs-ds__item.is-active {
		border-bottom-color: var(--teal-500);
	}
	.tabs-ds__sublabel {
		font-size: 11.5px;
		font-weight: 500;
		color: var(--text-muted);
	}
</style>
