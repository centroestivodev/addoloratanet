---
// Card orizzontale condivisa da appuntamenti e notizie: immagine a filo sul lato sinistro,
// a destra (nell'ordine) la riga meta, il titolo, l'anteprima e il contenuto dello slot di default.
import Icon from "./ui/Icon.astro";
import type { IconName } from "./ui/icons";

interface Props {
	href: string;
	title: string;
	image?: { src: string; alt?: string; position?: string };
	// "md": compatta (colonna degli appuntamenti, elenchi da telefono). "lg": più larga (elenco notizie)
	size?: "md" | "lg";
	excerpt?: string;
	placeholder?: IconName;
	class?: string;
}

const { href, title, image, size = "md", excerpt, placeholder = "newspaper", class: className } = Astro.props;
const hasMeta = Astro.slots.has("meta");
---

<a href={href} class:list={["media-card", `media-card--${size}`, className]}>
	<div class="media-card__media">
		{
			image ? (
				<img src={image.src} alt={image.alt ?? ""} loading="lazy" decoding="async" style={image.position ? { objectPosition: image.position } : undefined} />
			) : (
				<span class="media-card__placeholder">
					<Icon name={placeholder} size={size === "lg" ? 36 : 28} strokeWidth={1.5} />
				</span>
			)
		}
	</div>
	<div class="media-card__body">
		{
			hasMeta && (
				<div class="media-card__meta">
					<slot name="meta" />
				</div>
			)
		}
		<h3 class="media-card__title">{title}</h3>
		{excerpt && <p class="media-card__excerpt">{excerpt}</p>}
		<slot />
	</div>
</a>

<style>
	.media-card {
		display: flex;
		align-items: stretch;
		overflow: hidden;
		box-sizing: border-box;
		background: var(--surface-card);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
		color: inherit;
		text-decoration: none;
		font-family: var(--font-sans);
		transition: box-shadow var(--dur-base) var(--ease-out);
	}
	.media-card:hover {
		color: inherit;
		box-shadow: var(--shadow-md);
	}
	.media-card__media {
		flex: 0 0 96px;
		min-height: 120px;
		position: relative;
		overflow: hidden;
		background: var(--bg-muted);
		color: var(--stone-400);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.media-card__media img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform var(--dur-slow) var(--ease-out);
	}
	.media-card:hover .media-card__media img {
		transform: scale(1.03);
	}
	.media-card__placeholder {
		display: flex;
	}
	.media-card__body {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 8px;
		padding: 14px 16px;
	}
	.media-card__meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px 10px;
		font-size: 13px;
		font-weight: 500;
		color: var(--text-muted);
	}
	.media-card__title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 18px;
		line-height: 1.22;
		letter-spacing: -0.01em;
		color: var(--text-strong);
		text-wrap: balance;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.media-card:hover .media-card__title {
		color: var(--navy-700);
	}
	.media-card__excerpt {
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
		color: var(--text-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (min-width: 640px) {
		.media-card--md .media-card__media {
			flex-basis: 120px;
			min-height: 150px;
		}
		.media-card--md .media-card__body {
			padding: 16px;
		}
		.media-card--md .media-card__title {
			font-size: 20px;
		}
		.media-card--lg .media-card__media {
			flex-basis: 38%;
			min-height: 190px;
		}
		.media-card--lg .media-card__body {
			padding: 20px 24px;
			gap: 10px;
		}
		.media-card--lg .media-card__title {
			font-size: 24px;
		}
		.media-card--lg .media-card__excerpt {
			font-size: 15px;
			line-height: 1.55;
			-webkit-line-clamp: 3;
		}
	}
</style>
