---
const { text, href } = Astro.props;
---

<a
	href={href}
	class="btn btn-circle bg-base-100/90 hover:bg-base-100 border-none shadow-lg h-20 w-20 sm:h-28 sm:w-28 lg:h-36 lg:w-36 p-3 sm:p-5 flex flex-col items-center justify-center gap-1 mx-auto"
>
	<div class="h-7 w-7 sm:h-10 sm:w-10 lg:h-14 lg:w-14 text-primary">
		<slot />
	</div>
	<span class="text-[0.65rem] sm:text-sm text-center leading-tight text-base-content">{text}</span>
</a>
