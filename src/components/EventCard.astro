---
// Appuntamento in forma di riga: data, titolo, orario, descrizione
import Icon from "./ui/Icon.astro";
import DateBadge from "./ui/DateBadge.astro";
import { formatCardTime } from "../sanity/lib/eventDate";
import type { EventCard } from "../sanity/lib/queries";

interface Props {
	event: EventCard;
	class?: string;
}

const { event, class: className } = Astro.props;
const time = formatCardTime(event);
---

<a href={`/eventi/${event.slug}`} class:list={["event-card", className]}>
	<DateBadge date={event.eventDate} showWeekday />
	<div class="event-card__body">
		<h3 class="event-card__title">{event.title}</h3>
		{
			time && (
				<span class="event-card__time">
					<Icon name="clock" size={15} color="var(--icon-brand)" />
					{time}
				</span>
			)
		}
		{event.description && <p class="event-card__desc">{event.description}</p>}
	</div>
	<span class="event-card__chevron"><Icon name="chevron-right" size={20} /></span>
</a>

<style>
	.event-card {
		display: flex;
		align-items: flex-start;
		gap: 18px;
		padding: 18px;
		text-decoration: none;
		color: inherit;
		font-family: var(--font-sans);
		background: var(--surface-card);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
		transition: box-shadow var(--dur-base) var(--ease-out);
		box-sizing: border-box;
		overflow: hidden;
	}
	.event-card:hover {
		box-shadow: var(--shadow-md);
		color: inherit;
	}
	.event-card__body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
		flex: 1;
		padding-top: 2px;
	}
	.event-card__title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 20px;
		line-height: 1.22;
		letter-spacing: -0.01em;
		color: var(--text-strong);
		text-wrap: balance;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.event-card:hover .event-card__title {
		color: var(--navy-700);
	}
	.event-card__time {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
		color: var(--text-muted);
	}
	.event-card__desc {
		margin: 0;
		font-size: 15px;
		line-height: 1.55;
		color: var(--text-body);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.event-card__chevron {
		align-self: center;
		color: var(--text-subtle);
		transition:
			transform var(--dur-base) var(--ease-out),
			color var(--dur-fast);
	}
	.event-card:hover .event-card__chevron {
		color: var(--navy-700);
		transform: translateX(3px);
	}
</style>
