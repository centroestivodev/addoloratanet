---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const siteName = "Parrocchia S. M. Addolorata";
const defaultDescription =
	"Parrocchia Santa Maria Addolorata a Roma: orari delle messe, avvisi, notizie e attività della comunità parrocchiale.";

const { title, description = defaultDescription, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="theme-color" content="#3ba8bb" />
		<link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/logo-icon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{pageTitle}</title>
	</head>
	<body class="bg-base-100 min-h-screen flex flex-col">
		<Navbar/>
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
